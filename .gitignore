# ==========================================
# PYTHON
# ==========================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pdb
*.egg-info/
dist/
build/
.eggs/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# ==========================================
# NODE / FRONTEND
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
frontend/dist/
.eslintcache

# ==========================================
# DOCKER & DATABASE VOLUMES
# ==========================================
docker-data/
pg-data/
influx-data/
redis-data/
rabbitmq-data/

# ==========================================
# APP DATA & SCANS
# ==========================================
data/scans/*.txt
data/scans/*.xml
!data/scans/.gitkeep

# Runtime state: the launcher writes its PID here on every start.
data/run/

# ==========================================
# BACKGROUND WORKERS
# ==========================================
celerybeat-schedule*
celerybeat-schedule-wal
celerybeat.pid
*.log

# ==========================================
# ENVIRONMENT / SECRETS
# ==========================================
.env
.env.local
.env.*.local

# ==========================================
# EDITOR / OS / AI ARTIFACTS
# ==========================================
.DS_Store
.idea/
.vscode/
*.swp
*.swo
.local/
.config/
attached_assets/

# Agent scratch space (attachments, background logs, probe files)
.zwork/
.freebuff/
.tmp/
*.tmp

# ==========================================
# LOCAL RUNTIME ARTIFACTS
# ==========================================
# SQLite file created by smoke tests / local runs
/smoke.db
*.sqlite3

# Service logs (netpulse.log is also caught by *.log above)
logs/

# Backup copies made while rewriting files
*.bak
*.orig

# Archives
*.zip
*.rar
*.tar.gz

# Temp files
/main.py
screenshots/

# ...except the UI evidence referenced by docs/ui-audit-*.md
!docs/screenshots/
!docs/screenshots/*.png