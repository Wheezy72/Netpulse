# ==========================================
# NETPULSE ENVIRONMENT CONFIGURATION
# ==========================================

# --- Security ---
# Signs every session token and peer-discovery message. Leave it empty and
# NetPulse generates a strong key at data/signing_key on first start (a
# placeholder value such as the old "change-me-to-a-random-string" is treated
# as unset and replaced). Set your own 32+ character value only if you want to
# control it, or need several instances to trust each other's broadcasts.
SECRET_KEY=
ENVIRONMENT=development

# Interactive API reference at /api/docs. Unset follows
# ENVIRONMENT (on in development, off in production). Set to true
# to publish the API document from a production install.
# ENABLE_API_DOCS=true

# Uploaded scripts run in a gVisor (runsc) container by default. Set this to
# true only on a development box you control: it runs them with the API's own
# Python interpreter and no containment.
# SCRIPTS_UNSANDBOXED=false

# Peers on the same network discover each other over signed UDP broadcasts.
# Credential synchronisation (copying the admin password hash between peers) is
# a separate, off-by-default switch: anyone holding SECRET_KEY could otherwise
# overwrite the admin hash from the LAN.
# PEER_CREDENTIAL_SYNC=false

# --- First-run onboarding ---
# A fresh database shows a "Set up this instance" screen and creates its first
# administrator there. Uncomment SETUP_TOKEN to require that token on that
# screen (recommended whenever the port is reachable beyond localhost).
# SETUP_TOKEN=generate-a-long-random-string
# For scripted installs, pre-create the administrator instead. It is forced to
# choose a new password on first sign-in.
# BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login
# BOOTSTRAP_ADMIN_USERNAME=admin
# Only trust X-Forwarded-For / X-Real-IP from a reverse proxy you control.
# TRUST_PROXY_HEADERS=false
# Session cookies are marked Secure automatically on an HTTPS request (or when
# X-Forwarded-Proto says https). Force it off/on only if the automatic choice
# is wrong for your setup: a Secure cookie served over plain http is dropped by
# the browser, and sign-in appears to do nothing.
# COOKIE_SECURE=true

# --- Database Credentials (REQUIRED for App) ---
# Docker Compose supplies DATABASE_URL and ignores POSTGRES_HOST; a bare-metal
# install talks to the local server, so localhost is the right value here.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=netpulse
POSTGRES_PASSWORD=netpulse_secure_pass
POSTGRES_DB=netpulse
# Optional: store the metrics table as a TimescaleDB hypertable. Leave false on
# plain PostgreSQL — every metric feature works without it.
# ENABLE_TIMESCALEDB=false

# --- Network Monitoring Targets ---
PULSE_GATEWAY_IP=auto            # Set to auto to automatically detect the gateway, or specify an IP
PULSE_ISP_IP=8.8.8.8
PULSE_CLOUDFLARE_IP=1.1.1.1


# --- Frontend CORS Configuration ---
# Allows the Vue frontend (on custom port 6969 or fallbacks) to talk to the FastAPI backend
CORS_ALLOW_ORIGINS=http://localhost:8000,http://localhost:6969,http://localhost:6970,http://localhost:5173

# --- Email alerts (Optional) ---
# Sent by the backend only when ENABLE_EMAIL_ALERTS is true and SMTP_HOST,
# ALERT_EMAIL_FROM and ALERT_EMAIL_TO are all set. The switches in Settings ->
# Notifications are consulted per account: enabling email there (with an
# address, or ALERT_EMAIL_TO as the fallback recipient) turns the matching
# alerts on, and the panel's own toggles decide which severities fire.
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=
SMTP_PORT=587
# auto = port 465 uses implicit TLS, everything else tries STARTTLS and falls
# back to plaintext for a local relay. Force with ssl|starttls|none.
SMTP_SECURITY=auto
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# A device is reported offline after this many minutes without a discovery
# refresh, and the daily digest goes out at DIGEST_HOUR local time.
# DEVICE_OFFLINE_MINUTES=15
# DIGEST_HOUR=8

# --- Router-verified inventory (Optional) ---
# A sweep only proves something answered; the router's own tables prove who
# holds an address. Enable one source and devices get marked "verified" (the
# router lists them) or stay "observed" (they answered, the router does not
# list them).
#
# ROUTER_SOURCE: off | auto | snmp | routeros | dnsmasq
#   auto tries every source configured below. `off` (the default) never queries a router.
ROUTER_SOURCE=off
# SNMP (generic: MikroTik, Huawei, ZTE, Ubiquiti, Cisco, TP-Link, OpenWrt).
# Cheap consumer boxes often have no SNMP — enable it under Administration →
# SNMP if the router offers it, otherwise leave ROUTER_SOURCE off.
# ROUTER_HOST=               # empty = the detected gateway
# ROUTER_SNMP_PORT=161
# ROUTER_SNMP_COMMUNITY=public
# MikroTik RouterOS API (reads /ip/arp and /ip/dhcp-server/lease):
# ROUTEROS_URL=192.168.1.1:8728
# ROUTEROS_USER=admin
# ROUTEROS_PASSWORD=change-me
# dnsmasq / Pi-hole leases file, one host per line:
# ROUTER_DHCP_LEASES_FILE=/var/lib/misc/dnsmasq.leases
# ROUTER_VERIFY_INTERVAL=300   # seconds between automatic pulls; 0 = on demand only

# --- SSH Console (Optional) ---
# The console connects with the password typed in the drawer and pins each
# host key on first use (data/known_hosts.json). Set this to false to refuse
# hosts NetPulse has never seen instead of trusting the first key.
# SSH_TRUST_ON_FIRST_USE=true
# SSH_CONNECT_TIMEOUT=10
# MAX_SSH_SESSIONS_PER_USER=4
# SSH_KNOWN_HOSTS_FILE=./data/known_hosts.json

# --- External APIs (Optional) ---
# OPENAI_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here

# --- Rogue DHCP Detection (Optional) ---
# ALLOWED_DHCP_SERVER_MACS=aa:bb:cc:dd:ee:ff,11:22:33:44:55:66

