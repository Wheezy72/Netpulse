# ==========================================
# NETPULSE ENVIRONMENT CONFIGURATION
# ==========================================

# --- Security ---
SECRET_KEY=change-me-to-a-random-string
ENVIRONMENT=development

# --- First-run onboarding ---
# A fresh database shows a "Set up this instance" screen and creates its first
# administrator there. Uncomment SETUP_TOKEN to require that token on that
# screen (recommended whenever the port is reachable beyond localhost).
# SETUP_TOKEN=generate-a-long-random-string
# For scripted installs, pre-create the administrator instead. It is forced to
# choose a new password on first sign-in.
# BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login
# BOOTSTRAP_ADMIN_USERNAME=admin
# Only trust X-Forwarded-For / X-Real-IP from a reverse proxy you control.
# TRUST_PROXY_HEADERS=false

# --- Database Credentials (REQUIRED for App) ---
POSTGRES_USER=netpulse
POSTGRES_PASSWORD=netpulse_secure_pass
POSTGRES_DB=netpulse

# --- Network Monitoring Targets ---
PULSE_GATEWAY_IP=auto            # Set to auto to automatically detect the gateway, or specify an IP
PULSE_ISP_IP=8.8.8.8
PULSE_CLOUDFLARE_IP=1.1.1.1


# --- Frontend CORS Configuration ---
# Allows the Vue frontend (on custom port 6969 or fallbacks) to talk to the FastAPI backend
CORS_ALLOW_ORIGINS=http://localhost:8000,http://localhost:6969,http://localhost:6970,http://localhost:5173

# --- External APIs (Optional) ---
# OPENAI_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here

# --- Rogue DHCP Detection (Optional) ---
# ALLOWED_DHCP_SERVER_MACS=aa:bb:cc:dd:ee:ff,11:22:33:44:55:66

# --- Storage (Optional) ---
# PCAP_STORAGE_DIR=/app/data/pcaps   # host-visible via the ./data/pcaps bind mount
